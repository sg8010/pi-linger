  "author": "sg8010",
  "contributors": [
    "Jesse Zhang"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sg8010/pi-linger.git"
  },
  "homepage": "https://github.com/sg8010/pi-linger#readme",
  "bugs": {
    "url": "https://github.com/sg8010/pi-linger/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "linger",
    "calm",
    "tui"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/linger/index.ts"
    ]
  }
}
